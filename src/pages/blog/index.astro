---
import MainLayout from '../../layouts/MainLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getAllPosts } from '../../lib/blog';

const posts = await getAllPosts();
---

<MainLayout title="全部文章｜Clarity Notes" description="浏览全部文章、分类与主题。">
	<!-- Page Header -->
	<section class="glass-panel p-6 sm:p-8 lg:p-10 mb-8">
		<span class="kicker mb-3 block">All Posts</span>
		<h1 class="text-title-1 text-slate-900 mb-4">文章</h1>
		<p class="text-body max-w-2xl">按时间浏览完整内容库，保持简洁、快速与专注的阅读体验。</p>
	</section>

	<!-- Posts Grid -->
	<section>
		<div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
			{posts.map((post) => <PostCard post={post} />)}
		</div>
		
		{posts.length === 0 && (
			<div class="glass-panel p-12 text-center">
				<svg class="w-16 h-16 mx-auto mb-4 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
					<path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
				</svg>
				<h3 class="text-title-3 text-slate-900 mb-2">暂无文章</h3>
				<p class="text-body">文章正在准备中，敬请期待。</p>
			</div>
		)}
	</section>
</MainLayout>
