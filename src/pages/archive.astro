---
import MainLayout from '../layouts/MainLayout.astro';
import { getAllPosts } from '../lib/blog';

const posts = await getAllPosts();

// Group posts by year
const postsByYear = posts.reduce((acc, post) => {
	const year = post.data.pubDate.getFullYear();
	if (!acc[year]) acc[year] = [];
	acc[year].push(post);
	return acc;
}, {} as Record<number, typeof posts>);

const years = Object.keys(postsByYear).sort((a, b) => Number(b) - Number(a));
---

<MainLayout title="归档｜65s Notes" description="按时间线查看全部文章。">
	<!-- Header -->
	<section class="glass-panel p-6 sm:p-8 lg:p-10 mb-6">
		<span class="kicker mb-3 block">Archive</span>
		<h1 class="text-title-1 text-slate-900 mb-4">归档</h1>
		<p class="text-body max-w-2xl">通过时间线查看内容更新节奏，快速定位历史文章。</p>
	</section>

	<!-- Archive Timeline -->
	<section class="space-y-6">
		{years.map((year) => (
			<div class="glass-panel overflow-hidden">
				<div class="px-5 sm:px-6 py-4 bg-slate-50/50 border-b border-slate-100">
					<h2 class="text-title-2 text-slate-900">{year}</h2>
					<span class="text-caption">{postsByYear[Number(year)].length} 篇文章</span>
				</div>
				<div class="divide-y divide-slate-100">
					{postsByYear[Number(year)].map((post) => (
						<a 
							href={`/blog/${post.id}/`}
							class="group flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-6 p-4 sm:px-6 hover:bg-slate-50/50 transition-colors"
						>
							<time class="text-caption font-mono w-24 flex-shrink-0">
								{post.data.pubDate.toLocaleDateString('zh-CN', { month: '2-digit', day: '2-digit' })}
							</time>
							<div class="flex-1 min-w-0">
								<h3 class="text-base font-medium text-slate-900 group-hover:text-blue-600 transition-colors truncate">
									{post.data.title}
								</h3>
								<p class="text-caption truncate mt-0.5">{post.data.description}</p>
							</div>
							<span class="inline-flex items-center px-2.5 py-1 rounded-md bg-slate-100 text-slate-600 text-xs font-medium w-fit">
								{post.data.category}
							</span>
						</a>
					))}
				</div>
			</div>
		))}
		
		{years.length === 0 && (
			<div class="glass-panel p-12 text-center">
				<svg class="w-16 h-16 mx-auto mb-4 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
					<path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
				</svg>
				<h3 class="text-title-3 text-slate-900 mb-2">暂无文章</h3>
				<p class="text-body">归档内容正在准备中。</p>
			</div>
		)}
	</section>
</MainLayout>
