---
import MainLayout from '../layouts/MainLayout.astro';
import { getCategories } from '../lib/blog';

const categories = await getCategories();
---

<MainLayout title="分类｜Clarity Notes" description="按分类浏览文章。">
	<!-- Header -->
	<section class="glass-panel p-6 sm:p-8 lg:p-10 mb-6">
		<span class="kicker mb-3 block">Categories</span>
		<h1 class="text-title-1 text-slate-900 mb-4">分类</h1>
		<p class="text-body max-w-2xl">从更稳定的主题结构进入内容，帮助读者快速建立上下文。</p>
	</section>

	<!-- Categories Grid -->
	<section class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
		{categories.map((item) => (
			<a 
				href={`/categories/${item.name.toLowerCase()}`}
				class="group glass-panel p-5 sm:p-6 transition-all duration-300 hover:shadow-xl hover:-translate-y-1"
			>
				<div class="flex items-start justify-between mb-3">
					<div class="w-10 h-10 rounded-lg bg-gradient-to-br from-blue-500 to-cyan-500 flex items-center justify-center">
						<svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
						</svg>
					</div>
					<span class="text-2xl font-bold text-slate-900 group-hover:text-blue-600 transition-colors">
						{item.count}
					</span>
				</div>
				<h3 class="text-title-3 text-slate-900 mb-1">{item.name}</h3>
				<p class="text-caption">{item.count} 篇文章</p>
			</a>
		))}
		
		{categories.length === 0 && (
			<div class="glass-panel p-12 text-center sm:col-span-2 lg:col-span-3">
				<svg class="w-16 h-16 mx-auto mb-4 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
					<path stroke-linecap="round" stroke-linejoin="round" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
				</svg>
				<h3 class="text-title-3 text-slate-900 mb-2">暂无分类</h3>
				<p class="text-body">文章分类正在整理中。</p>
			</div>
		)}
	</section>
</MainLayout>
