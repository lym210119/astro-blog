---
import MainLayout from '../layouts/MainLayout.astro';
import { getAllPosts } from '../lib/blog';

const posts = await getAllPosts();
const searchIndex = posts.map((post) => ({
	title: post.data.title,
	description: post.data.description,
	category: post.data.category,
	tags: post.data.tags,
	href: `/blog/${post.id}/`,
}));
---

<MainLayout title="搜索｜65s Notes" description="在博客中搜索文章。">
	<!-- Header -->
	<section class="glass-panel p-6 sm:p-8 lg:p-10 mb-6">
		<span class="kicker mb-3 block">Search</span>
		<h1 class="text-title-1 text-slate-900 mb-4">搜索内容</h1>
		<p class="text-body max-w-2xl">输入关键词，即时筛选标题、描述、分类与标签。</p>
	</section>

	<!-- Search Input -->
	<section class="glass-panel p-4 sm:p-6 mb-6">
		<div class="relative">
			<svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
				<path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
			</svg>
			<input 
				id="search-input" 
				class="w-full pl-12 pr-4 py-3.5 rounded-xl border border-slate-200 bg-white/70 text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all"
				type="search" 
				placeholder="搜索文章、分类或标签…" 
			/>
		</div>
	</section>

	<!-- Results -->
	<section class="space-y-3" id="search-results">
		{posts.map((post) => (
			<a 
				class="group glass-panel p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-6 transition-all hover:shadow-lg"
				href={`/blog/${post.id}/`} 
				data-search-item
			>
				<span class="inline-flex items-center px-3 py-1 rounded-full bg-blue-50 text-blue-600 text-sm font-medium w-fit">
					{post.data.category}
				</span>
				<div class="flex-1 min-w-0">
					<h3 class="text-title-3 text-slate-900 group-hover:text-blue-600 transition-colors truncate">
						{post.data.title}
					</h3>
					<p class="text-body text-sm mt-1 line-clamp-1">{post.data.description}</p>
				</div>
				<svg class="w-5 h-5 text-slate-300 group-hover:text-blue-500 transition-colors flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
				</svg>
			</a>
		))}
		
		<!-- Empty State -->
		<div id="no-results" class="hidden glass-panel p-12 text-center">
			<svg class="w-16 h-16 mx-auto mb-4 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
				<path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
			</svg>
			<h3 class="text-title-3 text-slate-900 mb-2">未找到相关文章</h3>
			<p class="text-body">请尝试使用其他关键词搜索。</p>
		</div>
	</section>
</MainLayout>

<script define:vars={{ searchIndex }}>
	const input = document.querySelector('#search-input');
	const results = [...document.querySelectorAll('[data-search-item]')];
	const noResults = document.querySelector('#no-results');
	
	input?.addEventListener('input', (event) => {
		const keyword = event.target.value.trim().toLowerCase();
		let visibleCount = 0;
		
		results.forEach((item, index) => {
			const target = searchIndex[index];
			const haystack = [target.title, target.description, target.category, ...(target.tags || [])].join(' ').toLowerCase();
			const isMatch = !keyword || haystack.includes(keyword);
			item.style.display = isMatch ? 'flex' : 'none';
			if (isMatch) visibleCount++;
		});
		
		if (noResults) {
			noResults.classList.toggle('hidden', visibleCount > 0);
		}
	});
</script>
