---
import MainLayout from '../layouts/MainLayout.astro';
import PostCard from '../components/PostCard.astro';
import { HOME_HERO } from '../consts';
import { getAllPosts, getFeaturedPosts, getCategories } from '../lib/blog';

const posts = await getAllPosts();
const featuredPosts = await getFeaturedPosts();
const categories = await getCategories();
---

<MainLayout>
	<!-- Hero Section -->
	<section class="glass-panel overflow-hidden">
		<div class="grid lg:grid-cols-[1.4fr_1fr] gap-6 lg:gap-8">
			<!-- Hero Content -->
			<div class="p-6 sm:p-8 lg:p-10 flex flex-col justify-center">
				<span class="kicker mb-3">{HOME_HERO.eyebrow}</span>
				<h1 class="text-display text-slate-900 mb-4 max-w-lg">
					{HOME_HERO.title}
				</h1>
				<p class="text-body text-lg mb-6 max-w-md">
					{HOME_HERO.description}
				</p>
				<div class="flex flex-wrap gap-3">
					<a class="btn btn-primary" href={HOME_HERO.primaryCta.href}>
						{HOME_HERO.primaryCta.label}
						<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
						</svg>
					</a>
					<a class="btn btn-secondary" href={HOME_HERO.secondaryCta.href}>
						{HOME_HERO.secondaryCta.label}
					</a>
				</div>
			</div>
			
			<!-- Stats Card -->
			<div class="glass-panel bg-white/40 m-4 sm:m-6 lg:m-0 lg:mr-6 lg:my-6 p-6 sm:p-8 flex flex-col justify-center">
				<div class="mb-6">
					<h3 class="text-title-2 text-slate-900 mb-2">阅读概览</h3>
					<p class="text-body text-sm">以静态优先的内容架构，组织设计、工程与数字体验。</p>
				</div>
				<div class="flex flex-wrap gap-2">
					{categories.slice(0, 5).map((item) => (
						<span class="chip">
							{item.name}
							<span class="text-slate-400">·</span>
							{item.count}
						</span>
					))}
				</div>
			</div>
		</div>
	</section>

	<!-- Featured Posts -->
	<section class="mt-8 sm:mt-10">
		<div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-6">
			<div>
				<span class="kicker mb-2 block">Featured</span>
				<h2 class="text-title-1 text-slate-900">精选文章</h2>
				<p class="text-body mt-2 max-w-lg">聚焦更完整的叙事、深入的观点与值得反复阅读的主题。</p>
			</div>
		</div>
		
		<div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
			{featuredPosts.map((post) => <PostCard post={post} />)}
		</div>
	</section>

	<!-- Stats Grid -->
	<section class="mt-8 sm:mt-10">
		<div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
			<div class="glass-panel p-6 text-center sm:text-left">
				<div class="text-3xl sm:text-4xl font-bold text-slate-900 mb-1">{posts.length}</div>
				<p class="text-body text-sm">已发布文章</p>
			</div>
			<div class="glass-panel p-6 text-center sm:text-left">
				<div class="text-3xl sm:text-4xl font-bold text-slate-900 mb-1">{categories.length}</div>
				<p class="text-body text-sm">主题分类</p>
			</div>
			<div class="glass-panel p-6 text-center sm:text-left">
				<div class="text-3xl sm:text-4xl font-bold text-slate-900 mb-1">100%</div>
				<p class="text-body text-sm">静态优先体验</p>
			</div>
		</div>
	</section>

	<!-- Latest Posts -->
	<section class="mt-8 sm:mt-10">
		<div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-6">
			<div>
				<span class="kicker mb-2 block">Latest</span>
				<h2 class="text-title-1 text-slate-900">最新内容</h2>
				<p class="text-body mt-2 max-w-lg">围绕体验设计、前端工程与内容系统持续更新。</p>
			</div>
			<a class="btn btn-secondary self-start sm:self-auto" href="/blog">
				查看全部
				<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
				</svg>
			</a>
		</div>
		
		<div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
			{posts.slice(0, 6).map((post) => <PostCard post={post} />)}
		</div>
	</section>
</MainLayout>
